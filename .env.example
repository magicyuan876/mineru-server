# ============================================================================
# Tianshu (天枢) - 环境变量配置示例
# ============================================================================
#
# 使用方式：
#   1. 复制此文件为 .env: cp .env.example .env
#   2. 根据实际情况修改配置
#   3. 使用 docker-compose up -d 启动服务
#
# ============================================================================

# ----------------------------------------------------------------------------
# 应用配置
# ----------------------------------------------------------------------------
API_PORT=8080
WORKER_PORT=8001
MCP_PORT=8002
FRONTEND_PORT=80

LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# JWT 认证配置
# ----------------------------------------------------------------------------
# 必填：生产环境必须修改为随机字符串（占位符会被拒绝启动）！
# 生成方式: openssl rand -hex 32（setup.sh 会自动生成）
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ----------------------------------------------------------------------------
# 初始管理员账号（首次部署必填）
# ----------------------------------------------------------------------------
# 全新部署（数据库为空）时必须设置 TIANSHU_ADMIN_PASSWORD，否则 API 服务启动失败
# 生成方式: openssl rand -hex 16（setup.sh 会自动生成）
# 已有管理员账号的存量部署可留空
TIANSHU_ADMIN_USERNAME=admin
TIANSHU_ADMIN_PASSWORD=CHANGE_THIS_TO_A_RANDOM_VALUE

# ----------------------------------------------------------------------------
# CORS 配置
# ----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80

# ----------------------------------------------------------------------------
# GPU 配置
# ----------------------------------------------------------------------------
# GPU 数量（Docker 分配）
GPU_COUNT=1

# 可见的 GPU 设备（Backend，逗号分隔）
CUDA_VISIBLE_DEVICES=0

# 每个 GPU 上并发运行的 Worker 进程数（litserve workers_per_device）
# ⚠️ 这是控制并发的唯一入口：litserve_worker.py 会忽略 --workers-per-device 命令行参数，
#    只读此环境变量。实际并发任务数 = GPU_COUNT × MAX_CONCURRENT_TASKS
# 同卡多进程时必须同步下调 MINERU_VIRTUAL_VRAM_SIZE（见下方模型下载配置段），否则会 CUDA OOM
MAX_CONCURRENT_TASKS=1

# 以下两项当前代码未读取，仅作历史保留
# 每个 GPU 的 Worker 数量
WORKER_GPUS=2

# Worker 批处理大小
MAX_BATCH_SIZE=4

# Worker 超时时间（秒）
WORKER_TIMEOUT=300

# Worker 内存限制（cgroup 硬上限：超过才被 OOM Killer 杀，不是预留、不会提前占用）
# 格式: 数字 + 单位（M/G），例如: 8G, 16G, 32G
# ⚠️ 需随 worker 进程数（GPU_COUNT × MAX_CONCURRENT_TASKS）一起放大，按每进程约 8G 估算；
#    默认 16G 只够单进程，多并发下会被误杀。注意 worker 是本编排中唯一设了内存上限的服务。
# deploy-pipeline.sh 会自动按 min(8G × 进程数, 物理内存 × 25%) 计算并写入此项
WORKER_MEMORY_LIMIT=16G

# Worker 内存软限制（仅在系统内存紧张时影响回收优先级，同样不预分配）
WORKER_MEMORY_RESERVATION=8G

# ----------------------------------------------------------------------------
# 文件配置
# ----------------------------------------------------------------------------
# 最大文件大小（字节，0 表示不限制）
MAX_FILE_SIZE=0

# Nginx 文件上传大小限制（0 表示不限制）
NGINX_CLIENT_MAX_BODY_SIZE=0

# ----------------------------------------------------------------------------
# PDF 拆分配置（大文件并行处理）
# ----------------------------------------------------------------------------
# 是否启用 PDF 自动拆分（true/false）
PDF_SPLIT_ENABLED=true

# PDF 拆分阈值（页数）
# 超过此页数的 PDF 会自动拆分为多个子任务并行处理
# 建议值: 500-1000 页
PDF_SPLIT_THRESHOLD_PAGES=500

# PDF 拆分块大小（页数）
# 每个子任务处理的页数
# 建议值: 300-500 页（根据服务器内存调整）
PDF_SPLIT_CHUNK_SIZE=250

# ----------------------------------------------------------------------------
# 数据库配置
# ----------------------------------------------------------------------------
DATABASE_PATH=/app/data/db/mineru_tianshu.db

# ----------------------------------------------------------------------------
# 模型下载配置
# ----------------------------------------------------------------------------
# 模型下载源:
#   - auto: 自动选择（优先 ModelScope，失败后尝试 HuggingFace）
#   - modelscope: ModelScope（国内推荐）
#   - huggingface: HuggingFace
#   - local: 离线模式（本地联网下载，然后直接复制模型到服务器上使用，以实现服务器下载模型失败的问题）
MODEL_DOWNLOAD_SOURCE=auto

# HuggingFace 镜像地址（国内加速）
HF_ENDPOINT=https://hf-mirror.com

# MinerU 虚拟显存大小（GB）——「每个 Worker 进程」的显存预算，MinerU 据此规划 batch
# 不设置时由代码自动检测为整卡显存；MAX_CONCURRENT_TASKS > 1 时必须显式设置为
# 「单卡显存 / MAX_CONCURRENT_TASKS」，否则每个进程都按整卡规划 → CUDA OOM
# deploy-pipeline.sh 会自动计算并写入此项
MINERU_VIRTUAL_VRAM_SIZE=8

# 离线模型外部目录（主机路径，需包含预下载的所有模型文件），仅用于离线部署 docker-compose.offline.yml
OFFLINE_MODELS_PATH=./models-offline

# ----------------------------------------------------------------------------
# RustFS 对象存储配置（可选）
# ----------------------------------------------------------------------------
# RustFS 是一个高性能对象存储服务，用于存储和分发图片
#
# 启用/禁用 RustFS（true=启用，false=禁用）
# - true:  使用 RustFS 存储图片（需要 CPU 支持 SSE4.1）
# - false: 使用本地文件服务（兼容所有 CPU）
#
# 默认: false（兼容旧 CPU）
RUSTFS_ENABLED=false

# RustFS 服务地址（容器内部）
RUSTFS_ENDPOINT=rustfs:9000

# RustFS 访问密钥（必填：严禁使用默认凭据，setup.sh 会自动生成随机值）
# 生成方式: openssl rand -hex 16（ACCESS_KEY）/ openssl rand -hex 32（SECRET_KEY）
RUSTFS_ACCESS_KEY=CHANGE_THIS_TO_A_RANDOM_VALUE
RUSTFS_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_VALUE

# RustFS 存储桶名称
RUSTFS_BUCKET=ts-img

# RustFS 是否使用 HTTPS
RUSTFS_SECURE=false

# RustFS 公开访问 URL（浏览器访问图片的地址）
#
# ⚠️  重要：仅在 RUSTFS_ENABLED=true 时需要配置
#     RustFS 端口仅绑定宿主机回环（127.0.0.1），浏览器统一经前端 nginx 的
#     /s3/ 路径反代访问图片，格式: http(s)://<前端地址>/s3
#
# 配置示例:
#   - 本机: RUSTFS_PUBLIC_URL=http://localhost/s3
#   - 局域网: RUSTFS_PUBLIC_URL=http://192.168.1.100/s3
#   - 公网/HTTPS: RUSTFS_PUBLIC_URL=https://files.your-domain.com/s3
#   - 无 nginx 的本地开发: RUSTFS_PUBLIC_URL=http://127.0.0.1:9000
#
# setup.sh 部署时会按服务器 IP 与前端端口自动改写
RUSTFS_PUBLIC_URL=http://localhost/s3

# RustFS 服务端口
RUSTFS_PORT=9000

# ----------------------------------------------------------------------------
# MCP Server 配置（可选）
# ----------------------------------------------------------------------------
# MCP 调后端 API 的地址（容器网络内）
API_BASE_URL=http://backend:8000

# MCP 访问密钥（逗号分隔，客户端调用 MCP 时需携带；留空表示不启用密钥校验）
MCP_API_KEYS=

# MCP 调后端 API 的服务凭据（对应后端的一个 API Key）
TIANSHU_API_KEY=

# ----------------------------------------------------------------------------
# Redis 队列配置（可选 - 解决 SQLite 并发瓶颈）
# ----------------------------------------------------------------------------
# 是否启用 Redis 队列（true/false）
# 默认: false（使用 SQLite 队列）
# 启用后可以提升高并发场景下的性能
#
# 使用方式:
#   1. 设置 REDIS_QUEUE_ENABLED=true
#   2. 启动 Docker 时使用: docker-compose --profile redis up -d
#   3. 不使用 --profile redis 时，Redis 容器不会启动
#
REDIS_QUEUE_ENABLED=false

# Redis 服务器配置（仅在 REDIS_QUEUE_ENABLED=true 时生效）
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# 启用 Redis 队列前必须设置（setup.sh 会在启用时自动生成随机值）
REDIS_PASSWORD=CHANGE_THIS_TO_A_RANDOM_VALUE

# ----------------------------------------------------------------------------
# 前端配置
# ----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080
